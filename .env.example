# Copy this file to .env and change every value before deploying.
# docker compose reads .env automatically.

POSTGRES_DB=mantis
POSTGRES_USER=mantis
# Change this for any shared or production deployment.
POSTGRES_PASSWORD=mantis

# Strongly recommended, and required by the prod profile. Use a long random value
# (>= 32 characters), e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

CORS_ORIGINS=http://localhost:8081
APP_BASE_URL=http://localhost:8081

# E-mail notifications are disabled until SMTP is configured.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=mantis@example.com

# Mantis-compatible REST (/api/rest) and SOAP (/api/soap) layer.
API_REST_ENABLED=true
API_SOAP_ENABLED=true
API_TOKEN_ENABLED=true
API_LOGGING_ENABLED=false
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_RPM=120
API_ATTACHMENT_MAX_BYTES=5242880

# Set SPRING_PROFILES_ACTIVE=prod for a production deployment. In that profile
# JWT_SECRET and ADMIN_PASSWORD are mandatory and no default credentials are used.
# SPRING_PROFILES_ACTIVE=prod
# ADMIN_PASSWORD=change-me
