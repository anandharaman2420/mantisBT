      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
    <operation name="mc_issue_notes_get">
      <soap:operation soapAction="http://futureware.biz/mantisconnect/mc_issue_notes_get"/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
    <operation name="mc_issue_note_add">
      <soap:operation soapAction="http://futureware.biz/mantisconnect/mc_issue_note_add"/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="MantisConnectService">
    <port name="MantisConnectPort" binding="tns:MantisConnectBinding">
      <soap:address location="http://localhost:8080/api/soap"/>
    </port>
  </service>

</definitions>
